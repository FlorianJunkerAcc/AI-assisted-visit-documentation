{
  "name": "aiAssistedVisitDocumentation",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/sqlite": "^3",
    "@sap-ai-sdk/openai": "^2.15.0",
    "@sap/cds": "^10",
    "@sap/xssec": "^3",
    "pdf-lib": "^1.17.1",
    "ws": "^8"
  },
  "devDependencies": {
    "@cap-js/cds-test": ">=0.3.0",
    "@sap/cds-dk": "^10",
    "@ui5/webcomponents": "2.29.0",
    "@ui5/webcomponents-base": "2.29.0",
    "@ui5/webcomponents-fiori": "2.29.0",
    "@ui5/webcomponents-icons": "2.29.0",
    "@ui5/webcomponents-localization": "2.29.0",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build:ui": "esbuild ui-src/ui5.js --bundle --minify --format=esm --outfile=app/ui5.bundle.js",
    "test": "node --test --test-concurrency=1"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "c4c": {
        "kind": "odata-v2",
        "credentials": {
          "destination": "SAP_Sales_Cloud_V1",
          "path": "/sap/c4c/odata/v1/c4codataapi"
        },
        "csrf": true,
        "csrfInBatch": true
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      },
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "alice": {
              "password": "alice",
              "roles": [
                "VisitDocumenter"
              ],
              "attr": {
                "email": "alice.sales@example.com"
              }
            },
            "carol": {
              "password": "carol",
              "roles": [
                "VisitDocumenter"
              ],
              "attr": {
                "email": "carol.sales@example.com"
              }
            },
            "bob": {
              "password": "bob",
              "roles": [],
              "attr": {
                "email": "bob.nobody@example.com"
              }
            }
          }
        }
      },
      "[hybrid]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "alice": {
              "password": "alice",
              "roles": [
                "VisitDocumenter"
              ],
              "attr": {
                "email": "alice.sales@example.com"
              }
            },
            "carol": {
              "password": "carol",
              "roles": [
                "VisitDocumenter"
              ],
              "attr": {
                "email": "carol.sales@example.com"
              }
            },
            "bob": {
              "password": "bob",
              "roles": [],
              "attr": {
                "email": "bob.nobody@example.com"
              }
            }
          }
        }
      }
    },
    "voice": {
      "sessionRetentionDays": 7,
      "aicore": {
        "resourceGroup": "default",
        "realtimeModel": "gpt-realtime",
        "transcriptionModel": "whisper-1"
      }
    }
  }
}
