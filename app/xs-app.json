{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "websockets": {
    "enabled": true
  },
  "routes": [
    {
      "source": "^/ws/voice",
      "destination": "srv-api",
      "authenticationType": "none"
    },
    {
      "source": "^/api/(.*)$",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(.*)$",
      "localDir": "webapp",
      "authenticationType": "xsuaa"
    }
  ]
}
