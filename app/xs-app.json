{
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/api/voice-token$",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/ws/voice",
      "destination": "srv-api",
      "authenticationType": "none",
      "websocketUpgrade": true
    },
    {
      "source": "^/api/(.*)$",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(.*)$",
      "localDir": ".",
      "authenticationType": "none"
    }
  ]
}
